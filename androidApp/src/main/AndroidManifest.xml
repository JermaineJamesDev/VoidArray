<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required for MulticastLock; without it inbound discovery packets are silently filtered. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Required by WifiManager.WifiLock. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Required with targetSdk 37: Android 17 blocks all LAN traffic (TCP both ways, UDP multicast and
        broadcast) without it. Requested at runtime by LocalNetworkPermissionGate. It is in the Nearby
        devices group and is ignored on Android 16 and below. Remove it if targetSdk ever drops below 37,
        where declaring it is not allowed.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
        Backup is off so a restore onto a new phone cannot clone this install's device id and key, which
        would make the two phones filter each other out as "self" and let either impersonate the other.
        allowBackup covers Android 11 and below; dataExtractionRules also covers device-to-device
        transfer on Android 12+, which allowBackup alone does not stop.
    -->
    <application
        android:name=".VoidArrayApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoidArray">
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
